[18.037182, "o", "\u001b[?25l\u001b[H\u001b[3Ggit\u001b[7Gstash\u001b[46G\u001b[32m# 先把目前還沒提交的修改收起來\r\u001b[2C\u001b[1B\u001b[39mgit switch --detach first-submission\u001b[46G\u001b[32m# 切到第一次送審\r\u001b[2C\u001b[1B\u001b[39mmake all \u001b[48G\u001b[32m產生當時的 Word 和 PDF\u001b[39m\u001b[K\r\u001b[13C\u001b[1Bprac\u001b[19Gi\u001b[21Ge\u001b[23G&& git stash p\u001b[38Gp\u001b[48G\u001b[32m回\u001b[52G原本的分支，取回修改\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m注意\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWord\u001b[10G和\u001b[13GPDF\u001b[17G沒有存進版本庫，因為\u001b[38G\u001b[38;5;105moutput/\u001b[46G\u001b[39m被\u001b[49G\u001b[38;5;105m.gitignore\r\u001b[2C\u001b[1B\u001b[39m  排除，所以是從來源檔重新產生，內容會一樣，但不是當時那份檔案。\r\u001b[4C\u001b[1B如果要保留一份「當時送出的實體檔」，建議送件當下就把 \u001b[38;5;105moutput/\u001b[66G\u001b[39m複製到別的資料夾，或另外存\u001b[93GPDF。\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mmake all\u001b[39m 會清掉 \u001b[38;5;105moutput/\u001b[39m 裡現有的檔案，所以切過去之前，如果要保留目前的文件，先複製出來。\r\u001b[4C\u001b[1B標籤只在本機。這個專案資料夾如果被刪掉，標籤也會跟著消失，重要的版本可以推送到遠端備份，但推送前請先告訴我，我會等\r\u001b[2C\u001b[1B \u001b[5G你確認。\u001b[14G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GCogitated for 6s · done 1:04 AM\r\u001b[2B\u001b[48;5;255m❯ \u001b[38;5;16m假裝你是審查委員，再幫我挑一次毛病。\u001b[39m                                                                                \r\u001b[2B\u001b[49m\u001b[38;5;241m \u001b[39m Reading generated SF003, SF005, SF002 text\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ rm -f reviewers/review_20261007_010442.md; git status --short | head; for f in SF003 SF005; do echo \"=== $f\"; \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mpdftotext -layout output/revised/${f}_*.pdf - | grep -v '^\\s*$' | head -45; done; echo === SF002; pdftotext \r\u001b[1B\u001b[39m     \u001b[38;5;241m-layout output/revised/SF002_*.pdf - | grep -v '^\\s*$' | sed\u001b[67G-n 1,80p\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
