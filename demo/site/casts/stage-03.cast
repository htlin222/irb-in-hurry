[7.386181, "o", "\u001b[?25l\u001b[H\u001b[17G\u001b[38;5;105m└\u001b[30G┬\u001b[44G┘\r\u001b[16C\u001b[1B\u001b[39m             \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[10C\u001b[1B\u001b[38;5;105moutput/*.pdf（送件版）  + \u001b[38Goutput/preview/*.png\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B補充：\u001b[30G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mmake templa\u001b[17Ges\u001b[39m 只需執行一次，用來下載官方空白表單。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mmake closure\u001b[18G\u001b[39m這類指令可臨時指定階段，不改動\u001b[49G\u001b[38;5;105mconfig.toml\u001b[39m。\r\u001b[2C\u001b[1B- \u001b[38;5;105mmake set-phase\u001b[20G\u001b[39m才會把階段寫進\u001b[35G\u001b[38;5;105mconfig.toml\u001b[39m。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GCrunched for 8s · done 12:52 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m我是醫師，我只需要改哪幾個檔案？\u001b[39m                                                                                    \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39m只需要改這三個檔案：\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────┬──────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[1B \u001b[3G│    檔案     │     \u001b[64G填什麼\u001b[116G│\r\u001b[2C\u001b[1B├─────────────┼──────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;5;105mconfig.toml\u001b[39m │ 研究的基本資料，例如題目、研究類型、經費、收案人數等，還有目前的送件階段  \u001b[116G│\r\u001b[7C\u001b[1B    \u001b[19G\u001b[38;5;105mphase\u001b[39m（新案、修正案、結案等）\u001b[52G      \u001b[92G \u001b[116G│\r\u001b[91C\u001b[1B────────────────────────┤\r\u001b[5C\u001b[1B\u001b[38;5;105mv.toml\u001b[39m    \u001b[23G團隊成員，例如主持人（PI）、協同主持人的學經                        \u001b[92G \u001b[116G│\r\u001b[91C\u001b[1B────────────────────────┘\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[7.793636, "o", "\u001b[?25l\u001b[H\u001b[11G\u001b[38;5;105moutput/*.pdf（送件版）  +  output/preview/*.png\r\u001b[29C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B補充：\u001b[11G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mmake templates\u001b[20G\u001b[39m只需執行一次，用來下載官方空白表單。\r\u001b[2C\u001b[1B- \u001b[38;5;105mmake closure\u001b[18G\u001b[39m這類指令可臨時指定階段，不改動\u001b[49G\u001b[38;5;105mconfig.toml\u001b[39m。\r\u001b[9C\u001b[1B\u001b[38;5;105ms\u001b[12Gt-phase\u001b[20G\u001b[39m才會把階段寫進 \u001b[38;5;105mconfig.toml\u001b[39m。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GCrunched for 8s · done 12:52 AM\u001b[35G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m我是醫師，我只需要改哪幾個檔案？\u001b[39m                                                                                    \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[39m 只需要改這三個檔案：\u001b[K\r\u001b[2B \u001b[3G┌─────────────────┬──────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[10G檔案\u001b[21G│\u001b[66G填什麼\u001b[116G│\r\u001b[2C\u001b[1B├\u001b[17G─\u001b[21G┼\u001b[116G┤\r\u001b[4C\u001b[1B\u001b[38;5;105mconfig.toml\u001b[17G\u001b[39m \u001b[21G│\u001b[23G研究的基本資料，例如題目、研究類型、經費、收案人數等，還有目前的送件階段\r\u001b[2C\u001b[1B│                 │ \u001b[38;5;105mphase\u001b[39m（新案、修正案、結案等）                                                                │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[4C\u001b[1B\u001b[38;5;105mcv.toml\u001b[17G\u001b[39m \u001b[19G  │ 研究團隊成員，例如主持人（PI）、協同主持人的學經歷\r\u001b[16C\u001b[1B─\u001b[21G┼\r\u001b[4C\u001b[1B\u001b[38;5;105m中文計畫摘要.md\u001b[39m │ 長篇文字\u001b[37G研究背景、目的、方法。用 \u001b[38;5;105m## 標題\u001b[70G\u001b[39m分段，標\r\u001b[16C\u001b[1B─\u001b[21G┴\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[8.270451, "o", "\u001b[?25l\u001b[H\u001b[11G\u001b[K\r\u001b[2B\u001b[38;5;241m✻\u001b[3GCrunched for 8s · done 12:52 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m我是醫師，我只需要改哪幾個檔案？\u001b[39m                                                                                    \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39m只需要改這三個檔案：\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬──────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[1B  │      檔案       │                                            填什麼                                            │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[1B \u001b[3G│ \u001b[38;5;105mconfig.toml\u001b[39m     │ 研究的基本資料，例如題目、研究類型、經費、收案人數等，還有目前的送件階段\u001b[116G│\r\u001b[2C\u001b[1B│\u001b[21G│\u001b[23G\u001b[38;5;105mphase\u001b[39m（新案、修正案、結案等）\u001b[116G│\r\u001b[2C\u001b[1B├\u001b[21G┼\u001b[116G┤\r\u001b[4C\u001b[1B\u001b[38;5;105mcv.toml\u001b[39m  \u001b[23G研究團隊成員，例如主持人（PI）、協同主持人的學經歷\r\u001b[4C\u001b[2B\u001b[38;5;105m中文計畫摘要.md\u001b[23G\u001b[39m長篇文字，例如研究背景、目的、方法。用 \u001b[38;5;105m## 標題\u001b[39m 分段，標題會對應到表單欄位\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B注意事項：\u001b[21G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G其他檔案（\u001b[38;5;105mscripts/\u001b[39m、\u001b[38;5;105mMakefile\u001b[39m 等）都不用動。\u001b[K\r\u001b[2C\u001b[1B-\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
