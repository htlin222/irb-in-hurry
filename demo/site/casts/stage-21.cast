[11.441845, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u7528\u001b[8G\u001b[38;5;105mpdftotext\u001b[39m\u3001\u001b[38;5;105munzip\u001b[39m\u3001\u001b[38;5;105mgrep\u001b[31G\u001b[39m\u78ba\u8a8d\u4fee\u6539\u771f\u7684\u9032\u5230\u6587\u4ef6\uff0c\u518d\u7531\u6211\u5224\u65b7\u300c\u6709\u300d\u6216\u300c\u6c92\u6709\u300d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\u4eca\u5929\u6211\u81ea\u5df1\u51fa\u7684\u932f\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u4e00\u958b\u59cb\u8aaa\u001b[14GKFSYSCC\u001b[22G\u662f\u548c\u4fe1\u6cbb\u764c\u4e2d\u5fc3\u91ab\u9662\uff0c\u5c0d\u7167\u9810\u89bd\u5716\u4e0a\u7684\u6a5f\u69cb\u540d\u7a31\u78ba\u8a8d\u7121\u8aa4\u3002                  \r\u001b[4C\u001b[1B\u7b2c\u4e00\u6b21\u7528\u6574\u884c\u6bd4\u5c0d\u001b[22GPDF\uff0c\u8aa4\u4ee5\u70ba 10 \u5e74\u6c92\u9032\u53bb\uff0c\u5176\u5be6\u662f\u4e2d\u6587\u63db\u884c\uff1b\u53e6\u6709\u4e00\u6b21 \u001b[38;5;105munzip\u001b[39m \u8def\u5f91\u5beb\u932f\u3002\u5169\u6b21\u90fd\u662f\u91cd\u65b0\u6aa2\u67e5\u5f8c\u624d\u78ba\u8a8d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\u91cd\u9ede\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u7a0b\u5f0f\u80fd\u4fdd\u8b49\u683c\u5f0f\u4e00\u81f4\u3001\u53ef\u91cd\u73fe\uff0c\u4f46\u4e0d\u4fdd\u8b49\u5167\u5bb9\u6b63\u78ba\u3002\r\u001b[4C\u001b[1B\u5167\u5bb9\u7684\u6b63\u78ba\u6027\u5728 AI \u548c\u4f60\u8eab\u4e0a\u001b[33G\u6240\u4ee5\u9001\u4ef6\u524d\u7684\u771f\u5be6\u6578\u5b57\uff0870\uff0f150\u001b[63G\u4f8b\u3001IRB\r\u001b[2C\u001b[1B \u001b[5G\u7de8\u865f\u3001\u65e5\u671f\u3001\u7d50\u679c\uff09\u3001\u7c3d\u540d\u548c\u81e8\u5e8a\u5224\u65b7\uff0c\u6700\u5f8c\u90fd\u8981\u7531\u4f60\u78ba\u8a8d\u3002\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m\u273b\u001b[3GChurned for 16s \u00b7 done 1:08 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16m\u5982\u679c\u6211\u60f3\u5728\u81ea\u5df1\u7684\u79d1\u88e1\u958b\u59cb\u7528\u9019\u5957\u65b9\u6cd5\uff0c\u7b2c\u4e00\u6b65\u8a72\u505a\u4ec0\u9ebc\uff1f\u001b[39m                                                                \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m\u25cf\u001b[3G\u001b[39m\u001b[1m\u7b2c\u4e00\u6b65\uff1a\u6311\u4e00\u500b\u771f\u5be6\u3001\u7c21\u55ae\u7684\u56de\u6eaf\u6027\u7814\u7a76\uff0c\u7528\u9019\u5957\u65b9\u6cd5\u5b8c\u6574\u8dd1\u4e00\u6b21\u8a66\u9ede\uff0c\u4e0d\u8981\u4e00\u958b\u59cb\u5c31\u5168\u79d1\u63a8\u5ee3\u3002\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\u5177\u9ad4\u505a\u6cd5\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m\u9078\u6848\u5b50\u001b[22m\uff1a\u6311\u4f60\u81ea\u5df1\u624b\u4e0a\u4e00\u500b\u56de\u6eaf\u6027\u3001\u7c21\u6613\u5be9\u67e5\u3001\u514d\u77e5\u60c5\u540c\u610f\u7684\u7814\u7a76\uff0c\u9019\u985e\u6700\u55ae\u7d14\uff0c\u548c\u7bc4\u4f8b\u6700\u63a5\u8fd1\u3002\r\u001b[2C\u001b[1B2\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[12.270955, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1m\u4eca\u5929\u6211\u81ea\u5df1\u51fa\u7684\u932f\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u4e00\u958b\u59cb\u8aaa KFSYSCC\u001b[22G\u662f\u548c\u4fe1\u6cbb\u764c\u4e2d\u5fc3\u91ab\u9662\uff0c\u5c0d\u7167\u9810\u89bd\u5716\u4e0a\u7684\u6a5f\u69cb\u540d\u7a31\u78ba\u8a8d\u7121\u8aa4\u3002                  \r\u001b[2C\u001b[1B-\u001b[5G\u7b2c\u4e00\u6b21\u7528\u6574\u884c\u6bd4\u5c0d\u001b[22GPDF\uff0c\u8aa4\u4ee5\u70ba\u001b[34G10\u001b[37G\u5e74\u6c92\u9032\u53bb\uff0c\u5176\u5be6\u662f\u4e2d\u6587\u63db\u884c\uff1b\u53e6\u6709\u4e00\u6b21\u001b[72G\u001b[38;5;105munzip\u001b[78G\u001b[39m\u8def\u5f91\u5beb\u932f\u3002\u5169\u6b21\u90fd\u662f\u91cd\u65b0\u6aa2\u67e5\u5f8c\u624d\u78ba\u8a8d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\u91cd\u9ede\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u7a0b\u5f0f\u80fd\u4fdd\u8b49\u683c\u5f0f\u4e00\u81f4\u3001\u53ef\u91cd\u73fe\uff0c\u4f46\u4e0d\u4fdd\u8b49\u5167\u5bb9\u6b63\u78ba\u3002\r\u001b[2C\u001b[1B-\u001b[5G\u5167\u5bb9\u7684\u6b63\u78ba\u6027\u5728\u001b[20GAI\u001b[23G\u548c\u4f60\u8eab\u4e0a\uff0c\u6240\u4ee5\u9001\u4ef6\u524d\u7684\u771f\u5be6\u6578\u5b57\uff0870\uff0f150\u001b[63G\u4f8b\u3001IRB\r\u001b[2C\u001b[1B \u001b[5G\u7de8\u865f\u3001\u65e5\u671f\u3001\u7d50\u679c\uff09\u001b[25G\u7c3d\u540d\u548c\u81e8\u5e8a\u5224\u65b7\uff0c\u6700\u5f8c\u90fd\u8981\u7531\u4f60\u78ba\u8a8d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m\u273b\u001b[3GChurned for 16s \u00b7 done 1:08 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16m\u5982\u679c\u6211\u60f3\u5728\u81ea\u5df1\u7684\u79d1\u88e1\u958b\u59cb\u7528\u9019\u5957\u65b9\u6cd5\uff0c\u7b2c\u4e00\u6b65\u8a72\u505a\u4ec0\u9ebc\uff1f\u001b[39m                                                                \r\u001b[2B\u001b[49m\u001b[38;5;16m\u25cf\u001b[39m \u001b[1m\u7b2c\u4e00\u6b65\uff1a\u6311\u4e00\u500b\u771f\u5be6\u3001\u7c21\u55ae\u7684\u56de\u6eaf\u6027\u7814\u7a76\uff0c\u7528\u9019\u5957\u65b9\u6cd5\u5b8c\u6574\u8dd1\u4e00\u6b21\u8a66\u9ede\uff0c\u4e0d\u8981\u4e00\u958b\u59cb\u5c31\u5168\u79d1\u63a8\u5ee3\u3002\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m\u5177\u9ad4\u505a\u6cd5\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1m\u9078\u6848\u5b50\u001b[22m\uff1a\u6311\u4f60\u81ea\u5df1\u624b\u4e0a\u4e00\u500b\u56de\u6eaf\u6027\u3001\u7c21\u6613\u5be9\u67e5\u3001\u514d\u77e5\u60c5\u540c\u610f\u7684\u7814\u7a76\uff0c\u9019\u985e\u6700\u55ae\u7d14\uff0c\u548c\u7bc4\u4f8b\u6700\u63a5\u8fd1\u3002\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m\u7528\u771f\u5be6\u8cc7\u6599\u53d6\u4ee3\u7bc4\u4f8b\u001b[22m\uff1a\u5f9e\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u8f09\u5165\u7bc4\u4f8b\u7576\u8d77\u9ede\uff0c\u628a\u4e09\u500b\u6a94\u6848\u63db\u6210\u4f60\u7684\u8cc7\u6599\u3002\u7bc4\u4f8b\u88e1\u7684\u81e8\u5e8a\u5167\u5bb9\u662f\u793a\u610f\u7528\u7684\uff0c\u771f\u5be6\u7684\u6578\u5b57\u3001\u65e5\u671f\u3001IRB\u001b[96G\u7de8\u865f\u90fd\u8981\u81ea\u5df1\u586b\u3002\r\u001b[2C\u001b[1B3\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[12.74516, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[22B\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在\u001b[67GWindows\u001b[75G或\u001b[78GMac\u001b[82G上跑\u001b[87G\u001b[38;5;105mmake all\u001b[39m，看\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[13.149141, "o", "\u001b[?25l\u001b[H\u001b[3G- \u4e00\u958b\u59cb\u8aaa KFSYSCC\u001b[22G\u662f\u548c\u4fe1\u6cbb\u764c\u4e2d\u5fc3\u91ab\u9662\uff0c\u5c0d\u7167\u9810\u89bd\u5716\u4e0a\u7684\u6a5f\u69cb\u540d\u7a31\u78ba\u8a8d\u7121\u8aa4\u3002                  \r\u001b[2C\u001b[1B-\u001b[5G\u7b2c\u4e00\u6b21\u7528\u6574\u884c\u6bd4\u5c0d\u001b[22GPDF\uff0c\u8aa4\u4ee5\u70ba\u001b[34G10\u001b[37G\u5e74\u6c92\u9032\u53bb\uff0c\u5176\u5be6\u662f\u4e2d\u6587\u63db\u884c\uff1b\u53e6\u6709\u4e00\u6b21\u001b[72G\u001b[38;5;105munzip\u001b[78G\u001b[39m\u8def\u5f91\u5beb\u932f\u3002\u5169\u6b21\u90fd\u662f\u91cd\u65b0\u6aa2\u67e5\u5f8c\u624d\u78ba\u8a8d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\u91cd\u9ede\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u7a0b\u5f0f\u80fd\u4fdd\u8b49\u683c\u5f0f\u4e00\u81f4\u3001\u53ef\u91cd\u73fe\uff0c\u4f46\u4e0d\u4fdd\u8b49\u5167\u5bb9\u6b63\u78ba\u3002\r\u001b[2C\u001b[1B-\u001b[5G\u5167\u5bb9\u7684\u6b63\u78ba\u6027\u5728\u001b[20GAI\u001b[23G\u548c\u4f60\u8eab\u4e0a\uff0c\u6240\u4ee5\u9001\u4ef6\u524d\u7684\u771f\u5be6\u6578\u5b57\uff0870\uff0f150\u001b[63G\u4f8b\u3001IRB\r\u001b[2C\u001b[1B \u001b[5G\u7de8\u865f\u3001\u65e5\u671f\u3001\u7d50\u679c\uff09\u001b[25G\u7c3d\u540d\u548c\u81e8\u5e8a\u5224\u65b7\uff0c\u6700\u5f8c\u90fd\u8981\u7531\u4f60\u78ba\u8a8d\u3002\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m\u273b\u001b[3GChurned for 16s \u00b7 done 1:08 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16m\u5982\u679c\u6211\u60f3\u5728\u81ea\u5df1\u7684\u79d1\u88e1\u958b\u59cb\u7528\u9019\u5957\u65b9\u6cd5\uff0c\u7b2c\u4e00\u6b65\u8a72\u505a\u4ec0\u9ebc\uff1f\u001b[39m                                                                \r\u001b[2B\u001b[49m\u001b[38;5;16m\u25cf\u001b[39m \u001b[1m\u7b2c\u4e00\u6b65\uff1a\u6311\u4e00\u500b\u771f\u5be6\u3001\u7c21\u55ae\u7684\u56de\u6eaf\u6027\u7814\u7a76\uff0c\u7528\u9019\u5957\u65b9\u6cd5\u5b8c\u6574\u8dd1\u4e00\u6b21\u8a66\u9ede\uff0c\u4e0d\u8981\u4e00\u958b\u59cb\u5c31\u5168\u79d1\u63a8\u5ee3\u3002\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m\u5177\u9ad4\u505a\u6cd5\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1m\u9078\u6848\u5b50\u001b[22m\uff1a\u6311\u4f60\u81ea\u5df1\u624b\u4e0a\u4e00\u500b\u56de\u6eaf\u6027\u3001\u7c21\u6613\u5be9\u67e5\u3001\u514d\u77e5\u60c5\u540c\u610f\u7684\u7814\u7a76\uff0c\u9019\u985e\u6700\u55ae\u7d14\uff0c\u548c\u7bc4\u4f8b\u6700\u63a5\u8fd1\u3002\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m\u7528\u771f\u5be6\u8cc7\u6599\u53d6\u4ee3\u7bc4\u4f8b\u001b[22m\uff1a\u5f9e\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u8f09\u5165\u7bc4\u4f8b\u7576\u8d77\u9ede\uff0c\u628a\u4e09\u500b\u6a94\u6848\u63db\u6210\u4f60\u7684\u8cc7\u6599\u3002\u7bc4\u4f8b\u88e1\u7684\u81e8\u5e8a\u5167\u5bb9\u662f\u793a\u610f\u7528\u7684\uff0c\u771f\u5be6\u7684\u6578\u5b57\u3001\u65e5\u671f\u3001IRB\u001b[96G\u7de8\u865f\u90fd\u8981\u81ea\u5df1\u586b\u3002\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1m\u5728\u6709\u6a19\u6977\u9ad4\u7684\u96fb\u8166\u4e0a\u8dd1\u001b[22m\uff1a\u6211\u9019\u908a\u6c92\u6709\u6a19\u6977\u9ad4\uff0c\u9810\u89bd\u6392\u7248\u4e0d\u6e96\u3002\u4f60\u8981\u5728\u001b[67GWindows\u001b[75G\u6216\u001b[78GMac\u001b[82G\u4e0a\u8dd1\u001b[87G\u001b[38;5;105mmake all\u001b[39m\uff0c\u770b\r\u001b[5C\u001b[1B\u001b[38;5;105moutput/preview/compare/\u001b[39m \u7684\u5c0d\u7167\u5716\uff0c\u78ba\u8a8d\u548c\u5b98\u65b9\u7a7a\u767d\u8868\u55ae\u6c92\u6709\u660e\u986f\u8d70\u6a23\u3002\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[13.551876, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[22B\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的\u001b[48GPDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[13.952864, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1m重點\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- 程式能保證格式一致、可重現，但不保證內容正確。\r\u001b[2C\u001b[1B-\u001b[5G內容的正確性在\u001b[20GAI\u001b[23G和你身上，所以送件前的真實數字（70／150\u001b[63G例、IRB\r\u001b[2C\u001b[1B \u001b[5G編號、日期、結果）\u001b[25G簽名和臨床判斷，最後都要由你確認。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GChurned for 16s · done 1:08 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m如果我想在自己的科裡開始用這套方法，第一步該做什麼？\u001b[39m                                                                \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[39m \u001b[1m第一步：挑一個真實、簡單的回溯性研究，用這套方法完整跑一次試點，不要一開始就全科推廣。\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m具體做法\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在\u001b[67GWindows\u001b[75G或\u001b[78GMac\u001b[82G上跑\u001b[87G\u001b[38;5;105mmake all\u001b[39m，看\r\u001b[5C\u001b[1B\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[5C\u001b[1BSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[14.827401, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G內容的正確性在\u001b[20GAI\u001b[23G和你身上，所以送件前的真實數字（70／150\u001b[63G例、IRB\r\u001b[2C\u001b[1B  編號、日期、結果）、簽名和臨床判斷，最後都要由你確認。\r\u001b[2B\u001b[38;5;241m✻\u001b[3GChurned for 16s · done 1:08 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m如果我想在自己的科裡開始用這套方法，第一步該做什麼？\u001b[39m                                                                \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[3G\u001b[39m\u001b[1m第一步：挑一個真實、簡單的回溯性研究，用這套方法完整跑一次試點，不要一開始就全科推廣。\r\u001b[2B\u001b[22m  \u001b[1m具體做法\u001b[22m\u001b[K\r\u001b[2B \u001b[3G1. \u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m   載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在\u001b[67GWindows\u001b[75G或\u001b[78GMac\u001b[82G上跑\u001b[87G\u001b[38;5;105mmake all\u001b[39m，看\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的\u001b[48GPDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[5C\u001b[1BSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1m同時用平常\u001b[18G方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[15.208496, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GChurned for 16s · done 1:08 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m如果我想在自己的科裡開始用這套方法，第一步該做什麼？\u001b[39m                                                                \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39m\u001b[1m第一步：挑一個真實、簡單的回溯性研究，用這套方法完整跑一次試點，不要一開始就全科推廣。\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m具體做法\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從 \u001b[38;5;105mmake init\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在 Windows 或 Mac 上跑 \u001b[38;5;105mmake all\u001b[39m，看\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[2C\u001b[1B  \u001b[6GSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1m同時用平常的方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[19G\u001b[39m內含\u001b[24GPI\u001b[27G的電話和\u001b[36Gemail，不要把整個資料夾推送到公開的地方。\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[15.619506, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m如果我想在自己的科裡開始用這套方法，第一步該做什麼？\u001b[39m                                                                \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[39m \u001b[1m第一步：挑一個真實、簡單的回溯性研究，用這套方法完整跑一次試點，不要一開始就全科推廣。\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m具體做法\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在\u001b[67GWindows\u001b[75G或\u001b[78GMac\u001b[82G上跑\u001b[87G\u001b[38;5;105mmake all\u001b[39m，看\r\u001b[5C\u001b[1B\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[5C\u001b[1BSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1m同時用平常的方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[39m 內含\u001b[24GPI\u001b[27G的電話和\u001b[36Gemail，不要把整個資料夾推送到公開的地方。\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m版本控制\u001b[22m：想清楚要一個人維護，還是每個研究各一個分支或資料夾。目前的做法一個資料夾對應一個研究，同時做多個研究會互\r\u001b[2C\u001b[1B \u001b[5G相覆蓋。\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[16.029538, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m如果我想在自己的科裡開始用這套方法，第一步該做什麼？\u001b[39m                                                                \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39m\u001b[1m第一步：挑一個真實、簡單的回溯性研究，用這套方法完整跑一次試點，不要一開始就全科推廣。\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m具體做法\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從 \u001b[38;5;105mmake init\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在 Windows 或 Mac 上跑 \u001b[38;5;105mmake all\u001b[39m，看\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[2C\u001b[1B  \u001b[6GSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1m同時用平常的方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[19G\u001b[39m內含\u001b[24GPI\u001b[27G的電話和\u001b[36Gemail，不要把整個資料夾推送到公開的地方。\r\u001b[4C\u001b[1B\u001b[1m版本控制\u001b[22m：想清楚要一個人維護，還是每個研究各一\u001b[53G分支或資料夾。目前的做法一個資料夾對應一個研究，同時做多個研究會互\r\u001b[2C\u001b[1B \u001b[5G相覆蓋。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m誰負責更新\u001b[22m：官方表單改版時，要有人重新下載範本（\u001b[38;5;105mmake templates\u001b[39m）並檢查產生器。\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[16.916857, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[1m具體做法\u001b[22m\u001b[K\r\u001b[2B \u001b[3G1. \u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從\u001b[29G\u001b[38;5;105mmake init\r\u001b[2C\u001b[1B\u001b[39m   載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在\u001b[67GWindows\u001b[75G或\u001b[78GMac\u001b[82G上跑\u001b[87G\u001b[38;5;105mmake all\u001b[39m，看\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的\u001b[48GPDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[5C\u001b[1BSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1m同時用平常\u001b[18G方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[39m 內含 PI 的電話和 email，不要把整個資料夾推送到公開的地方。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m版本控制\u001b[22m：想清楚要一個人維護，還是每個研究各一個分支或資料夾。目前的做法一個資料夾對應一個研究，同時做多個研究會互\r\u001b[2C\u001b[1B  相覆蓋。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m誰負責更新\u001b[22m：官方表單改版時，要有人重新下載範本（\u001b[38;5;105mmake templates\u001b[39m）並檢查產生器。\r\u001b[4C\u001b[1B\u001b[1m內容審查\u001b[22m：程式不會判斷研究設計對不對。委員真正會挑的是設計問題，像存活者偏差，這些仍要靠人。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m這套方法適合與不適合\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[17.330618, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1m具體做法\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從 \u001b[38;5;105mmake init\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在 Windows 或 Mac 上跑 \u001b[38;5;105mmake all\u001b[39m，看\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[2C\u001b[1B  \u001b[6GSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1m同時用平常的方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[19G\u001b[39m內含\u001b[24GPI\u001b[27G的電話和\u001b[36Gemail，不要把整個資料夾推送到公開的地方。\r\u001b[4C\u001b[1B\u001b[1m版本控制\u001b[22m：想清楚要一個人維護，還是每個研究各一\u001b[53G分支或資料夾。目前的做法一個資料夾對應一個研究，同時做多個研究會互\r\u001b[2C\u001b[1B \u001b[5G相覆蓋。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m誰負責更新\u001b[22m：官方表單改版時，要有人重新下載範本（\u001b[38;5;105mmake templates\u001b[39m）並檢查產生器。\r\u001b[4C\u001b[1B\u001b[1m內容審查\u001b[22m：程式不會判斷研究設計對不對。委員真正會挑的是設計問題，像存活者偏差，這些仍要靠人。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m這套方法適合與不適合\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m適合\u001b[22m：重複性高的表單（基本資料、檢核表、結案）、多個研究共用同一套格式。\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[17.760766, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m選案子\u001b[22m：挑你自己手上一個回溯性、簡易審查、免知情同意的研究，這類最單純，和範例最接近。\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1m用真實資料取代範例\u001b[22m：從 \u001b[38;5;105mmake init\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G載入範例當起點，把三個檔案換成你的資料。範例裡的臨床內容是示意用的，真實的數字、日期、IRB\u001b[96G編號都要自己填。\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1m在有標楷體的電腦上跑\u001b[22m：我這邊沒有標楷體，預覽排版不準。你要在 Windows 或 Mac 上跑 \u001b[38;5;105mmake all\u001b[39m，看\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;105moutput/preview/compare/\u001b[39m 的對照圖，確認和官方空白表單沒有明顯走樣。\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1m跟 IRB 辦公室確認\u001b[22m：先請辦公室看一份產出的 PDF，問他們是否接受這種做法，以及表單版本是不是最新。例如這套產生的\r\u001b[2C\u001b[1B  \u001b[6GSF019 頁尾版本是 2018/01/02，我無法判斷它現在是否還有效。\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1m同時用平常的方式也準備一份\u001b[22m：第一次不要只靠這套，兩份對照過，才知道省了多少時間、有沒有漏。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m推廣前要先處理的事\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m個資\u001b[22m：\u001b[38;5;105mcv.toml\u001b[19G\u001b[39m內含\u001b[24GPI\u001b[27G的電話和\u001b[36Gemail，不要把整個資料夾推送到公開的地方。\r\u001b[4C\u001b[1B\u001b[1m版本控制\u001b[22m：想清楚要一個人維護，還是每個研究各一\u001b[53G分支或資料夾。目前的做法一個資料夾對應一個研究，同時做多個研究會互\r\u001b[2C\u001b[1B \u001b[5G相覆蓋。\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m誰負責更新\u001b[22m：官方表單改版時，要有人重新下載範本（\u001b[38;5;105mmake templates\u001b[39m）並檢查產生器。\r\u001b[4C\u001b[1B\u001b[1m內容審查\u001b[22m：程式不會判斷研究設計對不對。委員真正會挑的是設計問題，像存活者偏差，這些仍要靠人。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m這套方法適合與不適合\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m適合\u001b[22m：重複性高的表單（基本資料、檢核表、結案）、多個研究共用同一套格式。\r\u001b[4C\u001b[1B\u001b[1m不適合\u001b[22m：全部替你決定。表單產生器只負責格式，內容和簽名一定要由 PI 負責\r\u001b[2C\u001b[1B\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
