[10.494558, "o", "\u001b[?25l\u001b[H\r\u001b[2B  \u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39m已存檔，在 \u001b[38;5;105mpractice\u001b[39m 分支上提交為\u001b[36G\u001b[38;5;105m8976922\u001b[39m，並加上標籤\r\u001b[2C\u001b[1B\u001b[38;5;105mfirst-submission\u001b[39m，說明是「第一次送審」。標籤名稱用英文，是為了避免中文標籤在某些工具裡出問題。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B存進去的是 \u001b[38;5;105mconfig.toml\u001b[39m、\u001b[38;5;105mcv.toml\u001b[39m 和 \u001b[38;5;105m中文計畫摘要.md\u001b[39m 這三個來源檔。\u001b[38;5;105moutput/\u001b[39m 被 \u001b[38;5;105m.gitignore\u001b[39m 排除，所以\u001b[101GWord\u001b[106G和\u001b[109GPDF\r\u001b[2C\u001b[1B沒有進版本庫。要還原這一版時，切回標籤再跑一次\u001b[50G\u001b[38;5;105mmake all\u001b[59G\u001b[39m就能重新產出：\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1Bgit switch --detach first-submission && make all\u001b[K\r\u001b[2C\u001b[2B這個提交和標籤只在本機，沒有推送到遠端。\u001b[K\r\u001b[2B\u001b[38;5;241m✻\u001b[3GWorked for 10s · done 12:56 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m審查委員說：樣本數 220 的計算依據不清楚，請在統計分析補充說明。請照意見修改。\u001b[39m                                       \r\u001b[2B\u001b[49m\u001b[38;5;241m \u001b[39m Finding sample size and statistics section\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ sed -n 15,52p 中文計畫摘要.md; sed -n 20,40p config.toml; grep -rn '220' --include=*.md --include=*.toml . | \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mgrep -v '^./output' | head\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
