[16.436836, "o", "\u001b[?25l\u001b[H\u001b[3G├───────┼──────────────────────┼──────────────────────────────┤\r\u001b[2C\u001b[1B│ SF002 │ 研究計畫申請書\u001b[34G│\u001b[36G研究主體資料，PI\u001b[53G要簽名\u001b[65G│\r\u001b[2C\u001b[1B├───────┼──────────────────────┼──────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[9G3\u001b[11G│ 簡易審查範圍檢核表\u001b[32G  │ 說明為何符合簡易審查  \u001b[59G \u001b[61G    │\r\u001b[2C\u001b[1B├───────┼──────────────────────┼──────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GSF005\u001b[11G│\u001b[13G免取得知情同意檢核表\u001b[34G│\u001b[36G回溯性研究申請免知情同意\u001b[65G│\r\u001b[2C\u001b[1B├───────┼──────────────────────┼──────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GSF094 │ 顯著財務利益申報表\u001b[34G│\u001b[36G利益衝突申報，PI\u001b[53G要簽名\u001b[65G│\r\u001b[2C\u001b[1B├───────┼──────────────────────┼──────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G— \u001b[8G  \u001b[11G│ 中文計畫摘要\u001b[26G      \u001b[34G│\u001b[36G由\u001b[39G\u001b[38;5;105m中文計畫摘要.md\u001b[55G\u001b[39m產生\u001b[65G│\r\u001b[2C\u001b[1B└───────┴──────────────────────┴──────────────────────────────┘\r\u001b[2C\u001b[2B\u001b[1mSF001 的樣子\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- 上半部是 IRB 編號、計畫名稱（中英文）、主持人和單位，這些都是從\u001b[69G\u001b[38;5;105mconfig.toml\u001b[81G\u001b[39m帶進來的。\r\u001b[2C\u001b[1B-\u001b[5G下半部是送件核對表。■\u001b[27G代表需要備妥的文件，例如\u001b[52GSF002、中文計畫摘要、研究計畫書、PI\u001b[88G學經歷、SF094\u001b[102G和\u001b[105GSF003。□\r\u001b[1B \u001b[3G  代表這個案子用不到的，例如受試者同意書、CRF\u001b[49G和免予審查檢核。\r\u001b[2B  這張預覽圖用的是替代字型，不是標楷體。圖上的機構名稱是「和信治癌中心醫院」，之前我說的 KFSYSCC\u001b[K\r\u001b[2C\u001b[1B是林口長庚，我寫錯了。\r\u001b[1B\u001b[K\r\u001b[1B  其他表單的預覽圖在 \u001b[38;5;105moutput/preview/\u001b[39m，和官方版面的對照圖在\u001b[60G\u001b[38;5;105moutput/preview/compare/\u001b[39m。\r\u001b[13C\u001b[2B\u001b[38;5;241mrunning Stop hook · 9s · ↓\u001b[41G856 tokens)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[16.466858, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✽\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
