[11.969923, "o", "\u001b[?25l\u001b[H\u001b[3G└───────┴──────────────────────┴──────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSF001 的樣子\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- 上半部是 IRB 編號、計畫名稱（中英文）、主持人和單位，這些都是從\u001b[69G\u001b[38;5;105mconfig.toml\u001b[81G\u001b[39m帶進來的。\r\u001b[2C\u001b[1B-\u001b[5G下半部是送件核對表。■\u001b[27G代表需要備妥的文件，例如\u001b[52GSF002、中文計畫摘要、研究計畫書、PI\u001b[88G學經歷、SF094\u001b[102G和\u001b[105GSF003。□\r\u001b[2C\u001b[1B  代表這個案子用不到的，例如受試者同意書、CRF\u001b[49G和免予審查檢核。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B這張預覽圖用的是替代字型，不是標楷體。圖上的機構名稱是「和信治癌中心醫院」，之前我說的 KFSYSCC\u001b[K\r\u001b[2C\u001b[1B是林口長庚，我寫錯了。\u001b[K\r\u001b[2C\u001b[2B其他表單的預覽圖在 \u001b[38;5;105moutput/preview/\u001b[39m，和官方版面的對照圖在 \u001b[38;5;105moutput/preview/compare/\u001b[39m。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GBrewed for 9s · done 12:55 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m把這個版本存起來，標記為「第一次送審」。\u001b[39m                                                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mChecking\u001b[12Gbranch,\u001b[20Gstatus,\u001b[28Gignored\u001b[36Gpaths\r\u001b[1B\u001b[38;5;241m  ⎿  $ git add config.toml cv.toml 中文計畫摘要.md && git commit -q -m \"第一次送審：T-DXd HER2-low 新案送審資料\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mClaude-Session: https://claude.ai/code/session_012NPX47nbjqXpwBWCyyjLSa\" && git tag -a first-submission -m \r\u001b[1B\u001b[39m     \u001b[38;5;241m\"第一次送審\"\u001b[19G&& git log --oneline -1 && git tag -n\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
