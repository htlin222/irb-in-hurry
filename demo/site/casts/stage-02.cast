[9.54415, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16m\u7528\u4e09\u53e5\u8a71\u544a\u8a34\u6211\u9019\u500b\u5c08\u6848\u5728\u505a\u4ec0\u9ebc\u3002\u001b[39m                                                                                    \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m\u25cf\u001b[39m IRB-in-Hurry \u662f\u4e00\u500b\u81ea\u52d5\u5316\u5de5\u5177\uff0c\u7528\u4f86\u6e96\u5099 KFSYSCC\uff08\u548c\u4fe1\u6cbb\u764c\u4e2d\u5fc3\u91ab\u9662\uff09IRB \u502b\u7406\u5be9\u67e5\u6240\u9700\u7684\u9001\u4ef6\u6587\u4ef6\u3002\u001b[K\r\u001b[2C\u001b[1B\u4f60\u53ea\u8981\u5728\u001b[12G\u001b[38;5;105mconfig.toml\u001b[39m\uff08\u7814\u7a76\u8cc7\u6599\uff09\u3001\u001b[38;5;105mcv.toml\u001b[39m\uff08\u5718\u968a\uff09\u548c\r\u001b[2C\u001b[1B\u001b[38;5;105m\u4e2d\u6587\u8a08\u756b\u6458\u8981.md\u001b[39m\uff08\u6587\u5b57\u5167\u5bb9\uff09\u586b\u597d\u8cc7\u6599\uff0c\u7cfb\u7d71\u5c31\u6703\u4f9d\u7167\u9001\u4ef6\u968e\u6bb5\uff08\u65b0\u6848\u3001\u4fee\u6b63\u6848\u3001\u6301\u7e8c\u5be9\u67e5\u3001\u7d50\u6848\u3001SAE\r\u001b[1B  \u7b49\uff09\u548c\u7814\u7a76\u985e\u578b\uff0c\u6311\u51fa\u9700\u8981\u7684\u8868\u55ae\u3002\u001b[K\r\u001b[2C\u001b[1B\u5b83\u6703\u7522\u51fa\u6a19\u6977\u9ad4\u6392\u7248\u7684\u001b[24GWord\u001b[29G\u6a94\uff0c\u518d\u8f49\u6210\u001b[40GPDF\u001b[44G\u8207\u9810\u89bd\u5716\uff0c\u4e26\u7528\u7248\u9762\u6aa2\u67e5\u78ba\u8a8d\u001b[71G0\u001b[73G\u932f\u8aa4\u5f8c\u624d\u53ef\u9001\u4ef6\u3002\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m\u273b\u001b[3GCrunched for 3s \u00b7 done 12:52 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16m\u756b\u4e00\u5f35\u5716\uff1a\u6211\u586b\u7684\u8cc7\u6599\u600e\u9ebc\u8b8a\u6210 IRB \u9001\u5be9\u6587\u4ef6\uff1f\u001b[39m                                                                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m\u25cf\u001b[4G\u001b[38;5;105m\u4f60\u586b\u7684\u8cc7\u6599\uff08SSOT\uff0c\u7d14\u6587\u5b57\uff09\r\u001b[1B\u001b[39m \u001b[3G \u001b[38;5;105m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510 \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510 \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[3C\u001b[1B\u2502 config.toml     \u2502 \u2502 cv.toml   \u2502 \u2502 \u4e2d\u6587\u8a08\u756b\u6458\u8981.md   \u2502\r\u001b[1B\u001b[39m   \u001b[38;5;105m\u2502 \u7814\u7a76\u4e8b\u5be6\u3001phase  \u2502 \u2502 \u5718\u968a CV   \u2502 \u2502 \u9577\u7bc7\u6587\u5b57          \u2502\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518 \u2514\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518 \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[1B\u001b[39m \u001b[4G         \u001b[38;5;105m\u2502  \"@cv.toml#pi\" \u2502  \"@\u4e2d\u6587\u8a08\u756b\u6458\u8981.md\"   \u2502\r\u001b[3C\u001b[1B\u001b[39m         \u001b[38;5;105m\u2514\u001b[22G\u2500\u2500\u2500\u001b[30G\u253c\u001b[36G\u2500\u2500\u2500\u001b[51G\u2518\u001b[39m\u001b[K\r\u001b[3C\u001b[1B                          \u001b[38;5;105m\u25bc\u001b[39m\u001b[K\r\u001b[3C\u001b[1B             \u001b[38;5;105m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u001b[K\r\u001b[3C\u001b[1B             \u001b[38;5;105m\u2502 scripts/config.py \u001b[38G      \u2502  make check\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[9.988148, "o", "\u001b[?25l\u001b[H\u001b[3G你只要在\u001b[12G\u001b[38;5;105mconfig.toml\u001b[39m（研究資料）、\u001b[38;5;105mcv.toml\u001b[39m（團隊）和\r\u001b[1B  \u001b[38;5;105m中文計畫摘要.md\u001b[39m（文字內容）填好資料，系統就會依照送件階段（新案、修正案、持續審查、結案、SAE\u001b[K\r\u001b[2C\u001b[1B等）和研究類型，挑出需要的表單。\r\u001b[1B \u001b[3G它會產出標楷體排版的 Word 檔，再轉成 PDF 與預覽圖，並用版面檢查確認 0 錯誤後才可送件。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GCrunched for 3s · done 12:52 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m畫一張圖：我填的資料怎麼變成 IRB 送審文件？\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[3G\u001b[39m \u001b[38;5;105m你填的資料（SSOT，純文字）\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m┌─────────────────┐ ┌───────────┐ ┌──────────────────┐\r\u001b[1B\u001b[39m   \u001b[38;5;105m│ config.toml     │ │ cv.toml   │ │ 中文計畫摘要.md   │\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m│ 研究事實、phase  │ │ 團隊 CV   │ │ 長篇文字          │\r\u001b[1B\u001b[39m \u001b[4G\u001b[38;5;105m└────────┬────────┘ └─────┬─────┘ └────────┬─────────┘\r\u001b[3C\u001b[1B\u001b[39m         \u001b[38;5;105m│  \"@cv.toml#pi\" │  \"@中文計畫摘要.md\"   │\u001b[39m\u001b[K\r\u001b[3C\u001b[1B         \u001b[38;5;105m└────────────────┼────────────────────┘\u001b[39m\u001b[K\r\u001b[3C\u001b[1B                          \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[3C\u001b[1B             \u001b[38;5;105m┌\u001b[22G───\u001b[30G─\u001b[36G───\u001b[44G┐\u001b[39m\u001b[K\r\u001b[12C\u001b[1B    \u001b[38;5;105m│ scripts/config.py        │  make\u001b[52Gcheck\r\u001b[12C\u001b[1B\u001b[39m    \u001b[38;5;105m│ 解析 @ 引用 + 驗證欄位    │  (必填、列舉值、布林、預設值)\r\u001b[16C\u001b[1B└────────────┬─────────────┘\r\u001b[16C\u001b[1B\u001b[39m             \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m┌──────────────────────────┐\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[10.400171, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GCrunched for 3s · done 12:52 AM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m畫一張圖：我填的資料怎麼變成 IRB 送審文件？\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[3G\u001b[39m \u001b[38;5;105m你填的資料（SSOT，純文字）\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m┌─────────────────┐ ┌───────────┐ ┌──────────────────┐\r\u001b[1B\u001b[39m   \u001b[38;5;105m│ config.toml     │ │ cv.toml   │ │ 中文計畫摘要.md   │\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m│ 研究事實、phase  │ │ 團隊 CV   │ │ 長篇文字          │\r\u001b[1B\u001b[39m \u001b[4G\u001b[38;5;105m└────────┬────────┘ └─────┬─────┘ └────────┬─────────┘\r\u001b[3C\u001b[1B\u001b[39m         \u001b[38;5;105m│  \"@cv.toml#pi\" │  \"@中文計畫摘要.md\"   │\u001b[39m\u001b[K\r\u001b[3C\u001b[1B         \u001b[38;5;105m└────────────────┼────────────────────┘\u001b[39m\u001b[K\r\u001b[3C\u001b[1B                          \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[3C\u001b[1B             \u001b[38;5;105m┌\u001b[22G───\u001b[30G─\u001b[36G───\u001b[44G┐\u001b[39m\u001b[K\r\u001b[12C\u001b[1B    \u001b[38;5;105m│ scripts/config.py        │  make\u001b[52Gcheck\r\u001b[12C\u001b[1B\u001b[39m    \u001b[38;5;105m│ 解析 @ 引用 + 驗證欄位    │  (必填、列舉值、布林、預設值)\r\u001b[16C\u001b[1B└────────────┬─────────────┘\r\u001b[16C\u001b[1B\u001b[39m             \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m┌──────────────────────────┐\u001b[39m\u001b[K\r\u001b[18C\u001b[1B\u001b[38;5;105mform_selector.py      \u001b[44G│ \u001b[47G依 phase + 研究類型\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m│ FORM_REGISTRY            │  決定需要哪些表單\r\u001b[16C\u001b[1B└────────────┬─────────────┘\r\u001b[16C\u001b[1B\u001b[39m             \u001b[38;5;105m▼\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[10.810712, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m畫一張圖：我填的資料怎麼變成 IRB 送審文件？\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[39m  \u001b[38;5;105m你填的資料（SSOT，純文字）\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;105m┌─────────────────┐ ┌───────────┐ ┌──────────────────┐\r\u001b[1B\u001b[39m \u001b[4G\u001b[38;5;105m│ config.toml     │ │ cv.toml   │ │ 中文計畫摘要.md   │\r\u001b[3C\u001b[1B│ 研究事實、phase  │ │ 團隊 CV   │ │ 長篇文字          │\r\u001b[3C\u001b[1B└────────┬────────┘\u001b[24G└─────┬─────┘\u001b[38G└────────┬─────────┘\u001b[39m\u001b[K\r\u001b[3C\u001b[1B         \u001b[38;5;105m│  \"@cv.toml#pi\" │\u001b[32G \"@中文計畫摘要.md\"\u001b[54G│\u001b[39m\u001b[K\r\u001b[3C\u001b[1B         \u001b[38;5;105m└\u001b[22G───\u001b[30G┼\u001b[36G───\u001b[47G─\u001b[51G┘\u001b[39m\u001b[K\r\u001b[12C\u001b[1B                 \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[12C\u001b[1B    \u001b[38;5;105m┌\u001b[30G─\u001b[44G┐\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m│ scripts/config.py        │  make check\r\u001b[16C\u001b[1B│ 解析 @ 引用 + 驗證欄位    │  (必填、列舉值、布林、預設值)\r\u001b[16C\u001b[1B└────────────┬─────────────┘\u001b[39m\u001b[K\r\u001b[16C\u001b[1B             \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m┌\u001b[30G─\u001b[44G┐\r\u001b[16C\u001b[1B│ form_selector.py         │  依 phase + 研究類型\r\u001b[16C\u001b[1B│ FORM_REGISTRY            │  決定需要哪些表單\r\u001b[16C\u001b[1B└────────────┬─────────────┘\u001b[39m\u001b[K\r\u001b[16C\u001b[1B             \u001b[38;5;105m▼\u001b[39m\u001b[K\r\u001b[16C\u001b[1B\u001b[38;5;105m┌\u001b[30G─\u001b[44G┐\r\u001b[16C\u001b[1B│ generate_all.py          │  make all\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
